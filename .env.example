# Next.js app environment. Copy to .env.local and fill in. NEVER commit real values.

# Convex deployment URL. Written automatically to .env.local by `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=

# Clerk publishable key (public by design) from the Clerk dashboard > API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key. Server-only; never expose to the client or logs.
CLERK_SECRET_KEY=

# Optional: custom sign-in route if you build your own sign-in page.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
