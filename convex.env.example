# Convex DEPLOYMENT environment (not read by Next.js).
# Set each with: npx convex env set NAME value   (dev) or the Convex dashboard (prod).
# NEVER commit real values.

# Clerk Frontend API / issuer URL (Clerk dashboard > Convex integration), e.g. https://xxx.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Comma-separated Clerk user IDs allowed to act as admin (checked server-side by requireAdmin).
ADMIN_CLERK_USER_IDS=

# Outbound: n8n webhook URL that Convex calls on events (Phase 5).
N8N_WEBHOOK_URL=

# Outbound: shared secret used to sign requests to n8n (HMAC). Use a long random value.
N8N_WEBHOOK_SECRET=

# Inbound: bearer token n8n must present when calling Convex HTTP actions. Long random value.
N8N_INBOUND_TOKEN=

# Public base URL of the Next.js app, used for links in notifications.
APP_BASE_URL=
