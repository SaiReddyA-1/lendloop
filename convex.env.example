# Convex DEPLOYMENT environment (not read by Next.js).
# Set each with: npx convex env set NAME value   (dev) or the Convex dashboard (prod).
# NEVER commit real values.

# Clerk Frontend API / issuer URL (Clerk dashboard > Convex integration), e.g. https://xxx.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Comma-separated Clerk user IDs allowed to act as admin (checked server-side by requireAdmin).
ADMIN_CLERK_USER_IDS=

# Outbound: n8n webhook URL that Convex calls on loan events (Workflow 1), e.g. http://localhost:5678/webhook/lendloop-loan-events
# Must be https: in any shared/production setup. Plain http is accepted ONLY for localhost, 127.0.0.1, host.docker.internal and [::1]
# (otherwise events fail with INSECURE_WEBHOOK_URL, because the payload contains recipient name + email).
N8N_WEBHOOK_URL=

# Outbound: shared secret used to sign requests to n8n (HMAC-SHA256), min 32 chars (shorter = treated as NOT configured). generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Inbound: bearer token n8n must present on /api/n8n/* (store in an n8n Header Auth credential), min 32 chars (shorter = 503 not_configured). generate with: openssl rand -hex 32
N8N_INBOUND_TOKEN=

