# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- LendLoop additions ---
# env: ignore everything except templates
!.env.example
!convex.env.example
convex.env
convex.env.local
# convex local deployment state
/.convex/
# n8n local data
/n8n-data/
/.n8n/
/n8n/data/
/n8n/.n8n/


# n8n docker secrets (encryption key file): keep the folder, never the contents
/n8n/secrets/*
!/n8n/secrets/.gitkeep

# Generated by `next dev` (its managed block contains forbidden dash characters and is re-added on start)

# Third-party agent skills installed by tooling (contain forbidden dash characters; not project source)
/.agents/
/skills-lock.json
