# Copy to n8n/.env (git-ignored) and fill in. Placeholders only, never commit real values.
# Generate secrets with:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# Encrypts credentials stored in the n8n database. Back it up; losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-random-hex-64

GENERIC_TIMEZONE=UTC

# Must equal Convex env N8N_WEBHOOK_SECRET (Convex -> n8n HMAC-SHA256 signing secret).
LENDLOOP_WEBHOOK_SECRET=replace-with-random-hex-64

# Base URL of Convex HTTP actions (*.convex.site). Local Convex backend from inside Docker:
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

LENDLOOP_MAIL_FROM=LendLoop <noreply@lendloop.local>
LENDLOOP_ADMIN_ALERT_EMAIL=admin@lendloop.local

# NOT read by the n8n container. Export these in your shell only when running scripts/bootstrap.sh;
# they become the "LendLoop Convex inbound" / "LendLoop SMTP" credentials (encrypted by n8n).
# LENDLOOP_INBOUND_TOKEN=must-equal-Convex-N8N_INBOUND_TOKEN
# SMTP_HOST=mailpit
# SMTP_PORT=1025
